tmp/legged_data/*.pt
tmp/legged_data/*.jit
!*.onnx

# Isaac Gym / Physics cache
*.vhacd
.isaacgym/

# Environments & IDEs
.vscode/
.idea/
.venv/
env/
venv/
ENV/

